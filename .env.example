# ─────────────────────────────────────────────────────────────
# Nitro · Alcohol Intelligence — variáveis de ambiente locais
# ESTE ARQUIVO NÃO VAI PARA O GIT (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# Google Gemini (Google AI Studio)
GEMINI_API_KEY=cole-sua-chave-do-google-ai-studio-aqui

# Cadeia de fallback: da esquerda para a direita.
# Se um modelo falhar (cota 429, indisponível 5xx, inexistente 404),
# o próximo é tentado automaticamente.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite

# OpenWeatherMap
OPENWEATHER_API_KEY=cole-sua-chave-do-openweathermap-aqui

# Porta dos servidores locais (serve.ps1 / server.mjs)
PORT=8080
