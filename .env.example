# ─────────────────────────────────────────────────────────────
# Nitro · Alcohol Intelligence — variáveis de ambiente locais
# ESTE ARQUIVO NÃO VAI PARA O GIT (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# Google Gemini (Google AI Studio)
GEMINI_API_KEY=cole-sua-chave-do-google-ai-studio-aqui

# Cadeia de fallback: da esquerda para a direita.
# Se um modelo falhar (cota 429, indisponível 5xx, inexistente 404),
# o próximo é tentado automaticamente.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite

# OpenWeatherMap
OPENWEATHER_API_KEY=cole-sua-chave-do-openweathermap-aqui

# Porta dos servidores locais (serve.ps1 / server.mjs)
PORT=8080

# Origens extras autorizadas a chamar /api/chat e /api/weather (server.mjs).
# A mesma origem do request é sempre aceita; requisições sem Origin/Referer
# (curl, scripts) só passam de loopback. Separe por vírgula.
# ALLOWED_ORIGINS=https://meu-app.vercel.app

# ─────────────────────────────────────────────────────────────
# Supabase — formulário de suporte (tabela public.suporte_mensagens)
# Rode antes: supabase/001_suporte_mensagens.sql
#
# Use APENAS a publishable/anon key (sb_publishable_… ou o JWT "anon").
# Ela é pública por design e chega ao navegador; quem protege é a RLS,
# que só permite INSERT. NUNCA coloque a service_role (sb_secret_…) aqui.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-sua-publishable-key-aqui
